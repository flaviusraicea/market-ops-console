{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start -p 3200",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/?region=eu&market=de&product=veltrix&period=2026-03&mode=analyst"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3200/$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:performance": ["error", { "minScore": 0.9 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 266240 }],
            "total-byte-weight": ["error", { "maxNumericValue": 500000 }]
          }
        },
        {
          "matchingUrlPattern": "mode=analyst",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:performance": ["error", { "minScore": 0.9 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 368640 }],
            "total-byte-weight": ["error", { "maxNumericValue": 600000 }]
          }
        }
      ]
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
